<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_financeiro" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="NOME_CLIENTE" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGO" class="java.io.InputStream" isForPrompting="false"/>
    <queryString>
        <![CDATA[SELECT l.id, l.descricao, l.valor, l.data_vencimento, l.situacao, c.nome as categoria,
       COALESCE(cl.nome_empresarial, 'Sem cliente vinculado') as cliente
FROM lancamento l
JOIN categoria c ON l.id_categoria = c.id
LEFT JOIN cliente cl ON l.id_cliente = cl.id
WHERE UPPER(COALESCE(cl.nome_empresarial, '')) LIKE UPPER('%' || $P{NOME_CLIENTE} || '%')
ORDER BY l.data_vencimento DESC]]>
    </queryString>
    <field name="id" class="java.lang.Integer"/>
    <field name="descricao" class="java.lang.String"/>
    <field name="valor" class="java.math.BigDecimal"/>
    <field name="situacao" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <title>
        <band height="75">
            <image>
                <reportElement x="0" y="5" width="55" height="55"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="65" y="5" width="490" height="24"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <text><![CDATA[DOMINUS GESTOR EVOLUTION]]></text>
            </staticText>
            <staticText>
                <reportElement x="65" y="29" width="490" height="18"/>
                <textElement verticalAlignment="Middle"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Fluxo de Caixa e Lançamentos Financeiros]]></text>
            </staticText>
            <textField>
                <reportElement x="65" y="48" width="490" height="14"/>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{NOME_CLIENTE}.isEmpty() ? "Todos os clientes" : "Filtro: cliente contendo \"" + $P{NOME_CLIENTE} + "\""]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="20">
            <staticText><reportElement x="0" y="0" width="30" height="20"/><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="30" y="0" width="140" height="20"/><text><![CDATA[Cliente]]></text></staticText>
            <staticText><reportElement x="170" y="0" width="150" height="20"/><text><![CDATA[Descrição]]></text></staticText>
            <staticText><reportElement x="320" y="0" width="80" height="20"/><text><![CDATA[Categoria]]></text></staticText>
            <staticText><reportElement x="400" y="0" width="75" height="20"/><text><![CDATA[Valor (R$)]]></text></staticText>
            <staticText><reportElement x="475" y="0" width="80" height="20"/><text><![CDATA[Situação]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="30" height="20"/><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="30" y="0" width="140" height="20"/><textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression></textField>
            <textField><reportElement x="170" y="0" width="150" height="20"/><textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField>
            <textField><reportElement x="400" y="0" width="75" height="20"/><textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression></textField>
            <textField><reportElement x="475" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{situacao}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
